{
  "name": "caretranslate-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/pdf.worker.min.mjs",
    "postinstall": "patch-package && node scripts/copy-pdfjs-assets.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "patch-package": "8.0.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "undici": "8.10.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260801.1": true
  }
}
