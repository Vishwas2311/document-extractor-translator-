APP_NAME=CareTranslate Studio
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Authentication (required by default). Comma-separated bearer tokens.
AUTH_REQUIRED=true
API_AUTH_TOKENS=local-dev-token-change-me

# Optional JSON map from token -> {subject, organization_id, roles[]}.
# Unmapped tokens default to org_admin in org-local.
# API_AUTH_PRINCIPALS={"local-dev-token-change-me":{"subject":"caseworker-1","organization_id":"org-local","roles":["caseworker","reviewer"]}}

# Optional. If omitted, data/application.db is used.
DATABASE_URL=
STORAGE_ROOT=storage/documents
MAX_UPLOAD_SIZE_MB=150
MAX_DOCUMENT_PAGES=300
DI_PAGE_RANGE_SIZE=50
DI_RANGE_CONCURRENCY=2
DI_USE_PHYSICAL_CHUNKS=true
DI_DENSE_PAGE_THRESHOLD=0.65
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tif,tiff,bmp
RATE_LIMIT_PER_MINUTE=120
USE_CREATE_ALL=true

# Data Security Gateway
DEFAULT_PROCESSING_PROFILE=GENAI_PSEUDONYMIZED
DEFAULT_DATA_CLASS=synthetic
ALLOW_SYNTHETIC_RAW_LLM=true
GENAI_RAW_EXCEPTION_ENABLED=false
PSEUDONYMIZATION_SECRET=change-me-local-only

AZURE_AUTH_MODE=api_key
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-layout
AZURE_DOCUMENT_INTELLIGENCE_FEATURES=languages

# Financial extraction: local POC defaults to post-extraction filtering. Production
# should use selective with an approved Azure DI custom classifier ID.
FINANCIAL_EXTRACTION_MODE=post_extract
FINANCIAL_CLASSIFIER_MODEL_ID=
FINANCIAL_CLASSIFIER_VERSION=1.0
FINANCIAL_CLASSIFIER_SPLIT_MODE=perPage
FINANCIAL_INCLUDE_CONFIDENCE=0.65
FINANCIAL_EXCLUDE_CONFIDENCE=0.90
FINANCIAL_ADJACENT_PAGES=1

# Use the Azure v1 URL: https://RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_REASONING_EFFORT=minimal
AZURE_OPENAI_MAX_COMPLETION_TOKENS=12000

TARGET_LANGUAGE=en
TRANSLATION_MAX_BLOCKS=40
TRANSLATION_MAX_INPUT_CHARS=16000
TRANSLATION_CONCURRENCY=8
TRANSLATION_DEDUPE_IDENTICAL=true
TRANSLATION_PROGRESS_FLUSH_EVERY=4
OCR_REVIEW_THRESHOLD=0.85
AZURE_MAX_RETRIES=3
AZURE_REQUEST_TIMEOUT_SECONDS=180
PROCESSING_CONCURRENCY=2
JOB_LEASE_SECONDS=900
JOB_HEARTBEAT_SECONDS=30
RECOVERY_SWEEP_SECONDS=60
LOG_LEVEL=INFO
LOG_FORMAT=json
