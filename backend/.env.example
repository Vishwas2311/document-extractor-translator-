APP_NAME=CareTranslate Studio
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional. If omitted, data/application.db is used.
DATABASE_URL=
STORAGE_ROOT=storage/documents
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tif,tiff,bmp

AZURE_AUTH_MODE=api_key
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-layout
AZURE_DOCUMENT_INTELLIGENCE_FEATURES=languages

# Use the Azure v1 URL: https://RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_REASONING_EFFORT=minimal
AZURE_OPENAI_MAX_COMPLETION_TOKENS=8000

TARGET_LANGUAGE=en
TRANSLATION_MAX_BLOCKS=25
TRANSLATION_MAX_INPUT_CHARS=12000
OCR_REVIEW_THRESHOLD=0.85
AZURE_MAX_RETRIES=3
AZURE_REQUEST_TIMEOUT_SECONDS=180
PROCESSING_CONCURRENCY=1
JOB_LEASE_SECONDS=300
LOG_LEVEL=INFO
LOG_FORMAT=json
